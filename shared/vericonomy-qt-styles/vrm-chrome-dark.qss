/** Verium dark chrome tint — layered on vericonomy-shared-dark.qss (all OS).
 *  Source of truth: CodeRepo/shared/vericonomy-qt-styles/vrm-chrome-dark.qss */

QMainWindow {
    background-color: #3d4f5f;
}

QToolBar#mainToolBar {
    background-color: #3d4f5f;
    border-right: 1px solid rgba(0, 0, 0, 0.25);
}

QWidget#central {
    background-color: #4a6278;
}

QStatusBar,
QWidget#statusBar {
    background-color: #3d4f5f;
}

QProgressBar#progressBar,
QProgressBar#syncProgressBar {
    background-color: rgba(0, 0, 0, 0.35);
}

QProgressBar#progressBar::chunk,
QProgressBar#syncProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8aa8c0, stop: 0.5 #6887a2, stop: 1 #4a6278);
}

QWidget#bgWidget {
    background: rgba(74, 98, 120, 235);
}
