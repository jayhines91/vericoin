    padding: 5px 2px 5px 0px;
}

QDialog#SendCoinsDialog QLabel,
QDialog#SendCoinsDialog QScrollArea#scrollArea QLabelQCheckBox {
    font: 10pt "Lato";
    color: #46505A;
}

QDialog#SendCoinsDialog QLineEdit,
QDialog#SendCoinsDialog QAbstractSpinBox {
    border: no;
    border-bottom: 2px solid gray;
    border-top-right-radius: 3px;
    border-top-left-radius: 3px;
    background-color: #e6e6e6;
    height: 25px;
    padding: 0 4px;
    color: black;
    font: 11pt "Lato Light";
}

QDialog#SendCoinsDialog QLineEdit::focus,
QDialog#SendCoinsDialog QAbstractSpinBox::focus {
    background-color: #dcdcdc;
    border-bottom: 4px solid #418bca;
}

QDialog#SendCoinsDialog QAbstractSpinBox {
    max-width: 150px;
    padding-right: 0px;
}

QDialog#SendCoinsDialog QAbstractSpinBox::up-button,
QDialog#SendCoinsDialog QAbstractSpinBox::down-button {
    border: no;
}

QDialog#SendCoinsDialog QComboBox#unit {
    border: no;
    border-bottom: 2px solid gray;
    border-top-right-radius: 3px;
    border-top-left-radius: 3px;
    background-color: #e6e6e6;
    padding: 0px 10px 0px 10px;
    height: 25px;
