QDialog#OpenURIDialog QPushButton:!default,
QDialog#EditAddressDialog QPushButton:!default,
QDialog#SignVerifyMessageDialog QPushButton:!default,
QDialog#TransactionDescDialog QPushButton:!default,
QDialog#CoinControlDialog QPushButton:!default,
QDialog#CreateWalletDialog QPushButton:!default,
QWidget#RPCConsole QPushButton:!default,
QMessageBox QPushButton:!default {
    background-color: #3d4a58;
    color: #e4e9ef;
    border: 1px solid #4a5568;
}

QTabWidget::pane {
    border: 1px solid #3d4a58;
    background-color: #2a3441;
}

QTabBar::tab {
    background-color: #232d3a;
    color: #c5ced6;
    border: 1px solid #3d4a58;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background-color: #2a3441;
    color: #e4e9ef;
}

