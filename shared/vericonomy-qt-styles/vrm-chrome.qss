/** Verium chrome tint — coin-specific colors on vericonomy-shared.qss (all OS).
 *  Source of truth: CodeRepo/shared/vericonomy-qt-styles/vrm-chrome.qss */

QMainWindow {
    background-color: #586A7A;
}

QWidget#central {
    background-color: #6887a2;
}

QProgressBar#progressBar,
QProgressBar#syncProgressBar {
    background-color: rgba(0, 0, 0, 0.22);
}

QProgressBar#progressBar::chunk,
QProgressBar#syncProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #9ab4cc, stop: 0.5 #7a9bb8, stop: 1 #6887a2);
}

QWidget#CommunityPage QLabel#communityTitle {
    color: white;
}

QWidget#bgWidget {
    background: rgba(67, 138, 201, 235);
}
