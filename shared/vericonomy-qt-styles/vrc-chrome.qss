/** Vericoin chrome tint — coin-specific colors on vericonomy-shared.qss (all OS).
 *  Source of truth: CodeRepo/shared/vericonomy-qt-styles/vrc-chrome.qss */

QMainWindow {
    background-color: #586A7A;
}

QToolBar#tabBar QToolButton:checked {
    background-color: rgba(255, 255, 255, 0.18);
    border: none;
    padding: 6px;
}

QWidget#central {
    background-color: #5299cc;
}

QProgressBar#progressBar,
QProgressBar#syncProgressBar {
    background-color: rgba(0, 0, 0, 0.18);
}

QProgressBar#progressBar::chunk,
QProgressBar#syncProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7ecbf7, stop: 0.5 #5aafe8, stop: 1 #3b8fd9);
}

QWidget#CommunityPage QLabel#communityTitle {
    color: white;
}

QWidget#bgWidget {
    background: rgba(67, 138, 201, 235);
}
