}

QDialog#SendCoinsDialog QComboBox#unit::drop-down {
    background-color: #e6e6e6;
    background-image: url(:/icons/arrow-dark);
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-position: center;
}

QDialog#SendCoinsDialog QComboBox#unit QAbstractItemView {
    background-color: #e6e6e6;
    selection-color: #586A7A;
    border: no;
}

QDialog#SendCoinsDialog QPushButton {
    border: no;
    border-radius: 16px;
    height: 25px;
    padding: 5px 10px;
    background-color: #418bca;
    color: white;
    font: 10pt "Lato";
    font-weight: bold;
}

QDialog#SendCoinsDialog QPushButton:hover {
    background-color: #2d6a9f;
}

